{
  "ConnectionStrings": {
    "TeamTaskDB": "Server=(localdb)\\MSSQLLocalDB;Initial Catalog=TeamTaskDB;Integrated Security=True;Persist Security Info=true;Encrypt=False;Connection Timeout=1500;"
  },
  "Jwt": {
    "Issuer": "TeamTaskApi",
    "Audience": "TeamTaskApiAudience",
    "Secret": "TeamTask_APISecretKeyIsMeantForAuthorizingTheUserOfTheAppToKnowWhoToAuthenticateOrNot,",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
